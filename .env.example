# Set these as runtime secrets/variables in Coolify, never commit real values.
APP_ORIGIN=https://your-coolify-domain.example
# Use URL-safe random hex, since this is embedded in DATABASE_URL.
POSTGRES_PASSWORD=
# Generated with scripts/password-hash.mjs, not the plaintext password.
OWNER_PASSWORD_HASH=
# Base64-encoded random 32-byte encryption key. Back it up separately.
RESEARCH_ENCRYPTION_KEY=
# Keep false while transferring and checking data; set true after verification.
MONITOR_ENABLED=false
MONITOR_INTERVAL_SECONDS=60
OPENAI_API_KEY=
OPENAI_RESEARCH_MODEL=gpt-4.1-mini
ALPACA_API_KEY=
ALPACA_API_SECRET=
